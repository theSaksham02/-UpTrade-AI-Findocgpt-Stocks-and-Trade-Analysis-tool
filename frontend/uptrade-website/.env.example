# Accounts (Supabase Auth). Leave empty to run without sign-in: the terminal stays public either way.
# Supabase dashboard → Project Settings → API. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (A legacy anon key also works: NEXT_PUBLIC_SUPABASE_ANON_KEY=)
# Set to true after enabling the Google provider in Supabase (shows "Continue with Google")
NEXT_PUBLIC_AUTH_GOOGLE=

# Optional: Hugging Face token to score headlines with FinBERT (falls back to a finance lexicon)
HUGGINGFACE_API_KEY=
# Optional: only used by the legacy multi-chart grid
NEXT_PUBLIC_WS_URL=
